rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validPublicRequest() {
      return request.resource.data.status == '신규'
        && request.resource.data.privacyAgreed == true
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.createdAtClient is string;
    }

    match /quotes/{requestId} {
      allow create: if validPublicRequest();
      allow read, update, delete: if false;
    }

    match /samples/{requestId} {
      allow create: if validPublicRequest();
      allow read, update, delete: if false;
    }

    match /inquiries/{requestId} {
      allow create: if validPublicRequest();
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
