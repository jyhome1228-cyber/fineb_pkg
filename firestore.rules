rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function validPublicRequest() {
      return request.resource.data.status == '신규'
        && request.resource.data.privacyAgreed == true
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.createdAtClient is string;
    }

    match /quotes/{requestId} {
      allow create: if validPublicRequest();
      allow read, update, delete: if isAdmin();
    }

    match /samples/{requestId} {
      allow create: if validPublicRequest();
      allow read, update, delete: if isAdmin();
    }

    match /inquiries/{requestId} {
      allow create: if validPublicRequest();
      allow read, update, delete: if isAdmin();
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
