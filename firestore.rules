rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'whales84@naver.com';
    }

    function validPublicRequest(expectedType) {
      return request.resource.data.type == expectedType
        && request.resource.data.status == '신규'
        && request.resource.data.privacyAgreed == true
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.createdAtClient is string;
    }

    match /quotes/{requestId} {
      allow create: if isAdmin() || validPublicRequest('quote');
      allow read, update, delete: if isAdmin();
    }

    match /samples/{requestId} {
      allow create: if isAdmin() || validPublicRequest('sample');
      allow read, update, delete: if isAdmin();
    }

    match /inquiries/{requestId} {
      allow create: if isAdmin() || validPublicRequest('inquiry');
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
