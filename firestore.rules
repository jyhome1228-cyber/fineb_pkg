rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validPublicRequest(expectedType) {
      return request.resource.data.type == expectedType
        && request.resource.data.status == '신규'
        && request.resource.data.privacyAgreed == true
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.createdAtClient is string;
    }

    function validStatus() {
      return request.resource.data.status in [
        '신규',
        '확인중',
        '진행중',
        '견적완료',
        '완료',
        '보류'
      ];
    }

    function statusOnlyUpdate() {
      return validStatus()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'statusUpdatedAt',
          'updatedAtClient',
          'updatedAt'
        ]);
    }

    function validPortfolioCreate() {
      return request.resource.data.id is string
        && request.resource.data.id.size() > 3
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.cat in ['paper', 'gift', 'rigid', 'special']
        && request.resource.data.images is list
        && request.resource.data.images.size() > 0
        && request.resource.data.images.size() <= 20
        && request.resource.data.published == true
        && request.resource.data.source == 'cms'
        && request.resource.data.createdAtClient is string;
    }

    function validVisitCreate(visitId) {
      return request.resource.data.visitorId is string
        && request.resource.data.visitorId.size() >= 10
        && request.resource.data.visitorId.size() <= 80
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && visitId == request.resource.data.date + '_' + request.resource.data.visitorId
        && request.resource.data.firstPath is string
        && request.resource.data.firstPath.size() <= 160
        && request.resource.data.createdAtClient is string;
    }

    match /quotes/{requestId} {
      allow create: if validPublicRequest('quote');
      allow read: if true;
      allow update: if statusOnlyUpdate();
      allow delete: if false;
    }

    match /samples/{requestId} {
      allow create: if validPublicRequest('sample');
      allow read: if true;
      allow update: if statusOnlyUpdate();
      allow delete: if false;
    }

    match /inquiries/{requestId} {
      allow create: if validPublicRequest('inquiry');
      allow read: if true;
      allow update: if statusOnlyUpdate();
      allow delete: if false;
    }

    match /portfolio/{projectId} {
      allow read: if true;
      allow create: if validPortfolioCreate();
      allow update, delete: if false;
    }

    match /visits/{visitId} {
      allow read: if true;
      allow create: if validVisitCreate(visitId);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}